#!/usr/bin/env python3
# Which skills (and plugin commands) each agent sees, on the Mac and inside
# `dev` containers, with what their descriptions cost in context: every
# session loads each name + description up front, the body only when used.
# Usage: skills-audit > skills.md   (reads the VM only if it is running)
import glob, os, re, subprocess, sys, tarfile, io, tempfile

H = os.path.expanduser("~")


def meta(path):
    try:
        text = open(path, encoding="utf-8", errors="replace").read()
    except OSError:
        return None
    m = re.match(r"---\n(.*?)\n---", text, re.S)
    fm = m.group(1) if m else ""
    name = re.search(r"^name:\s*(.+)$", fm, re.M)
    # description may be a block scalar (description: >- / |) spanning lines
    d = re.search(r"^description:[ \t]*(.*(?:\n[ \t]+.*)*)", fm, re.M)
    desc = " ".join(re.sub(r"^[>|][-+]?", "", d.group(1)).split()) if d else ""
    return (name.group(1).strip().strip("\"'") if name else os.path.basename(os.path.dirname(path)),
            desc.strip("\"'"), len(text))


def skills_in(d, tag, deep=False):
    # Claude Code only looks one level down; Codex walks the tree (checked
    # against a Codex session log: archive/ and the skills/ submodule show up).
    pat = os.path.join(d, "**", "SKILL.md") if deep else os.path.join(d, "*", "SKILL.md")
    out = []
    for p in sorted(glob.glob(pat, recursive=True)):
        m = meta(p)
        if m:
            out.append((m[0], tag, m[1], m[2]))
    return out


def plugin_items(root, enabled):
    out = []
    # only the version installed_plugins.json points at; the cache keeps old ones
    try:
        installed = json.load(open(os.path.join(os.path.dirname(root), "installed_plugins.json")))["plugins"]
        versions = {tuple(e["installPath"].rstrip("/").split("/")[-3:]) for v in installed.values() for e in v}
    except (OSError, ValueError, KeyError, TypeError):
        versions = set()
    for pdir in sorted(glob.glob(os.path.join(root, "*", "*", "*"))):
        mkt, plug = pdir.split(os.sep)[-3:-1]
        if f"{plug}@{mkt}" not in enabled:
            continue
        if versions and tuple(pdir.split(os.sep)[-3:]) not in versions:
            continue
        # Claude namespaces plugin skills (plugin:skill), so they never collide with a user skill
        for p in glob.glob(os.path.join(pdir, "skills", "*", "SKILL.md")):
            m = meta(p)
            if m:
                out.append((f"{plug}:{m[0]}", f"plugin {plug}", m[1], m[2]))
        for p in glob.glob(os.path.join(pdir, "commands", "*.md")):
            m = meta(p)
            if m:
                    out.append((f"/{plug}:{os.path.basename(p)[:-3]}", f"plugin {plug} (command)", m[1], m[2]))
    return out


def dedupe(items):
    seen, out = set(), []
    for it in items:
        if it[0] not in seen:
            seen.add(it[0])
            out.append(it)
    return out


def table(title, items, note=""):
    items = dedupe(items)
    tok = sum(len(i[0]) + len(i[2]) for i in items) // 4
    print(f"\n## {title}\n\n{len(items)} items, ~{tok:,} tokens of descriptions in every session.{(' ' + note) if note else ''}\n")
    print("| skill | source | ~tok | description |\n|---|---|---|---|")
    for n, src, d, _ in sorted(items, key=lambda i: i[0].lower()):
        short = d if len(d) <= 160 else d[:157] + "..."
        print(f"| {n} | {src} | {(len(n) + len(d)) // 4} | {short.replace('|', '/')} |")


import json

agents = os.path.join(H, ".agents/skills")
shared = skills_in(agents, "~/.agents/skills")
shared_deep = skills_in(agents, "~/.agents/skills", deep=True)

# Mac Claude: ~/.claude/skills plus enabled plugins
try:
    enabled = {k for k, v in json.load(open(os.path.join(H, ".claude/settings.json"))).get("enabledPlugins", {}).items() if v}
except (OSError, ValueError):
    enabled = set()
mac_claude = skills_in(os.path.join(H, ".claude/skills"), "~/.claude/skills") + \
    plugin_items(os.path.join(H, ".claude/plugins/cache"), enabled)
codex = skills_in(os.path.join(H, ".codex/skills"), "~/.codex/skills", deep=True) + shared_deep
# opencode: assumed to walk the tree like Codex (not verified)
opencode = skills_in(os.path.join(H, ".config/opencode/skills"), "opencode/skills", deep=True) + \
    skills_in(os.path.join(H, ".claude/skills"), "~/.claude/skills", deep=True) + shared_deep

print("# Skills audit\n\nGenerated by `dot-agents/bin/skills-audit`. ~tok = (name + description) / 4: the "
      "always-loaded part; bodies load only when a skill is used. Built-in skills of each tool are not listed.")
table("Mac: Claude Code", mac_claude)
table("Mac: Codex", codex, "Plus Codex's bundled system skills.")
table("Mac: opencode", opencode, "Scan depth assumed, not verified.")

# dev containers: Claude sees ~/.agents/skills (the dotfiles export) plus the
# plugins installed in the VM's shared ~/.claude.
st = subprocess.run(["limactl", "list", "--format", "{{.Status}}", "dev"], capture_output=True, text=True).stdout.strip()
if st == "Running":
    tar = subprocess.run(["limactl", "shell", "--workdir", "/", "dev", "--", "sudo", "sh", "-c",
                          "cd /var/lib/dev/state/claude/plugins && tar -cf - installed_plugins.json "
                          "$(find cache -name SKILL.md -o -path '*/commands/*.md')"],
                         capture_output=True).stdout
    with tempfile.TemporaryDirectory() as t:
        try:
            tarfile.open(fileobj=io.BytesIO(tar)).extractall(t, filter="data")
        except tarfile.TarError:  # sudo or tar failed in the VM: empty stdout
            print("\n## dev containers: Claude Code\n\nCould not read the VM's plugins (`limactl shell dev sudo tar` failed).")
        else:
            try:
                ct_enabled = set(json.load(open(os.path.join(t, "installed_plugins.json")))["plugins"]) & enabled
            except (OSError, ValueError, KeyError):
                ct_enabled = set()
            ct = shared + plugin_items(os.path.join(t, "cache"), ct_enabled)
            table("dev containers: Claude Code", ct, f"Plugins enabled on the Mac but not installed here: "
                  f"{', '.join(sorted(enabled - ct_enabled)) or 'none'}.")
    table("dev containers: Codex", shared_deep, "Plus Codex's bundled system skills.")
else:
    print(f"\n## dev containers\n\nVM is {st or 'missing'}: start it (`dev`) and rerun.")
