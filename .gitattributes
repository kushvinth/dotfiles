# LF everywhere; git detects binaries itself
* text=auto eol=lf
*.png binary
*.jpg binary

# Generated: collapsed in diffs, left out of GitHub stats
nix/flake.lock linguist-generated

# Keep shaders out of GitHub's language bar
*.glsl linguist-detectable=false
*.vert linguist-detectable=false
*.frag linguist-detectable=false
*.geom linguist-detectable=false

# Count config formats in the language bar (Linguist hides data languages by default)
*.kdl   linguist-detectable
*.toml  linguist-detectable
*.yml   linguist-detectable
*.yaml  linguist-detectable

# opencode plugins: keep JS/TS out of the language bar
dot-config/opencode/plugins/** linguist-detectable=false

# Not live code: old backup and a generated icon table
dot-config/sketchybar/backup/** linguist-vendored
dot-config/sketchybar/plugins/icon_map.sh linguist-generated
