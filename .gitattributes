# LF everywhere; git detects binaries itself
* text=auto eol=lf
*.png binary
*.jpg binary

# Generated: collapsed in diffs, left out of GitHub stats
nix/flake.lock linguist-generated

# Keep shaders out of GitHub's language bar
*.glsl linguist-detectable=false
*.vert linguist-detectable=false
*.frag linguist-detectable=false
*.geom linguist-detectable=false
