{
  "$schema": "https://opencode.ai/config.json",

  // ─── Plugins ──────────────────────────────────────────────────────────────
  "plugin": ["opencode-ralph-loop", "@dietrichgebert/ponytail"],

  // ─── Providers ────────────────────────────────────────────────────────────
  // Local Ollama (OpenAI-compatible endpoint). gpt-oss-heretic needs the harmony
  // template from library/gpt-oss, or it replies empty and has no tool calls.
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": { "baseURL": "http://localhost:11434/v1" },
      "models": {
        // output cap covers both <think> tokens + visible reply; 16384 starves the reply on complex tasks
        "qwen3.6-heretic-32k": { "name": "Qwen3.6 35B-A3B Heretic (32k, low RAM)", "tool_call": true, "reasoning": true, "limit": { "context": 32768, "output": 32768 }, "temperature": 0.15 },
        "qwen3.6-heretic": { "name": "Qwen3.6 35B-A3B Heretic", "tool_call": true, "reasoning": true, "limit": { "context": 131072, "output": 65536 }, "temperature": 0.15 },
        "qwen3.6-heretic-q6": { "name": "Qwen3.6 35B-A3B Heretic Q6", "tool_call": true, "reasoning": true, "limit": { "context": 131072, "output": 65536 }, "temperature": 0.15 },
        "qwen3.8-27b-heretic": { "name": "Qwen3.8 27B Heretic", "tool_call": true, "reasoning": true, "limit": { "context": 65536, "output": 32768 }, "temperature": 0.15 }
      }
    },
    // Magnitude – local AI inference engine on the Mac (proxied into the
    // container by magnitude-proxy in dev-vm/default.nix). Speaks the OpenAI
    // wire format at /inference/v1. Models are whatever is loaded in Magnitude;
    // run `curl http://127.0.0.1:10100/inference/v1/models` to list them.
    // One-liner shorthand: `oc magnitude/model-name` (alias in .zshalias).
    "magnitude": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Magnitude (local)",
      "options": {
        "baseURL": "http://127.0.0.1:10100/inference/v1",
        "apiKey": "magnitude-local"
      },
      "models": {
        "lfm3-1.7b:gguf:q8": {
          "name": "Liquid LFM3 1.7B (Q8)",
          "tool_call": true,
          "reasoning": true,
          "limit": { "context": 262144, "output": 32768 }
        },
        "local:qwen35-q4_k_m:f30c9d51007e": {
          "name": "qwen3.8-27b-heretic:latest",
          "tool_call": true,
          "reasoning": true,
          "limit": { "context": 262144, "output": 32768 }
        },
        "local:qwen3.6-35b-a3b-uncensored-heretic-q4_k_m:1e0499dd6235": {
          "name": "qwen3.6-heretic-32k:latest",
          "tool_call": true,
          "reasoning": true,
          "limit": { "context": 262144, "output": 32768 }
        },
        "local:qwen3.6-35b-a3b-uncensored-heretic-q6_k:29b9c772247b": {
          "name": "qwen3.6-heretic-q6:latest",
          "tool_call": true,
          "reasoning": true,
          "limit": { "context": 262144, "output": 32768 }
        },
        "local:qwen38-ara-v5-q8_0:86c9d41284fb": {
          "name": "qwen3.8-27b-heretic-q8:latest",
          "tool_call": true,
          "reasoning": true,
          "limit": { "context": 262144, "output": 32768 }
        }
      }
    }
  },

  // ─── Permissions ──────────────────────────────────────────────────────────
  // Loose on purpose: the zsh `opencode` alias runs it under agent-jail
  // (dot-agents/sandbox/agents.sb), which is the real boundary. MCP packages
  // below are pinned; bump them by hand (docs/hardening.md).
  "permission": {
    "edit": "allow",
    "bash": {
      "*":        "allow",
      "rm -rf *": "deny",
      "sudo *":   "ask"
    }
  },

  // ─── Agents ───────────────────────────────────────────────────────────────
  // Tab key cycles through primary agents. Subagents are called via @name or
  // auto-spawned by the orchestrator when it needs parallel work.
  "agent": {
    // Primary: general-purpose builder (default)
    "build": {
      "mode": "primary",
      "description": "Default coding agent – write, edit, run code",
    },

    // Primary: planning-only, no file edits
    "plan": {
      "mode": "primary",
      "description": "Think through the approach before touching code. No edits.",
      "permission": { "edit": "deny", "bash": { "*": "deny" } }
    },

    // Subagent: web researcher – uses fetch + brave-search MCPs
    "researcher": {
      "mode": "subagent",
      "description": "Search the web and summarise findings. Mention @researcher.",
      "permission": {
        "edit": "deny",
        "bash": { "*": "deny" }
      }
    },

    // Subagent: memory keeper – reads/writes to memory MCP
    "memory-keeper": {
      "mode": "subagent",
      "hidden": true,
      "description": "Persist and recall facts across sessions via the memory MCP.",
      "permission": { "edit": "deny", "bash": { "*": "deny" } }
    },

    // Subagent: code reviewer
    "reviewer": {
      "mode": "subagent",
      "description": "Review code for bugs, style, and security. No edits.",
      "permission": { "edit": "deny", "bash": { "*": "deny" } }
    },

    // Subagent: tester
    "tester": {
      "mode": "subagent",
      "description": "Write and run tests. Focused only on test files.",
    },

    // Subagent: browser – drives Chromium via the Playwright MCP.
    // Call with @agent-browser or let the orchestrator route tasks like
    // "open this URL", "fill this form", "scrape that page", "take a screenshot".
    // No file edits, no bash: it only controls the browser and returns results.
    "agent-browser": {
      "mode": "subagent",
      "description": "Control a real Chromium browser: navigate, click, fill forms, scrape pages, take screenshots. Use @browser for any web automation task.",
      "permission": {
        "edit": "deny",
        "bash": { "*": "deny" }
      }
    }
  },

  // ─── MCP Servers ──────────────────────────────────────────────────────────
  // All servers below are FREE & open-source.
  // Servers that need tokens/keys are noted inline — get them for free.
  "mcp": {

    // ── OFFICIAL ANTHROPIC SERVERS ──────────────────────────────────────────

    // Filesystem – read/write files under ~/LocalStorage (projects), not all of $HOME
    "filesystem": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem@1.0.0",
                  "{env:HOME}/LocalStorage"],
      "enabled": true
    },

    // Fetch – pull any public web page as clean text
    "fetch": {
      "type": "local",
      "command": ["npx", "-y", "@kazuph/mcp-fetch@1.6.3"],
      "enabled": true
    },

    // Git – read logs, diffs, branches of local repos
    "git": {
      "type": "local",
      "command": ["uvx", "--with", "mcp==1.11.0", "mcp-server-git", "--repository",
                  "/Users/MacbookPro/.config/opencode"],
      "enabled": false   // pinned to one repo; opencode runs git itself
    },

    // Memory – knowledge-graph persistent memory (survives sessions!)
    "memory": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-memory@1.0.0"],
      "enabled": true
    },

    // Sequential Thinking – multi-step reasoning loop
    "sequential-thinking": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-sequential-thinking@1.0.0"],
      "enabled": false   // off: its tool definitions cost tokens every session
    },

    // Time – time & timezone queries
    "time": {
      "type": "local",
      "command": ["npx", "-y", "time-mcp@1.0.6"],
      "enabled": false   // off: its tool definitions cost tokens every session
    },

    // ── WEB SEARCH ──────────────────────────────────────────────────────────

    // SQLite – query any local .db file
    "sqlite": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-sqlite",
                  "--db-path", "./data.db"],
      "enabled": false   // ← enable per-project as needed
    },

    // PostgreSQL – point at your own Postgres instance
    "postgres": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-postgres@0.6.2",
                  "postgresql://user:pass@localhost:5432/mydb"],
      "enabled": false   // ← enable when you have a local PG running
    },

    // ── DEV TOOLS ───────────────────────────────────────────────────────────

    // GitHub – repos, PRs, issues, code search
    // Free token at: https://github.com/settings/tokens
    "github": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github@2025.4.8"],
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_PERSONAL_ACCESS_TOKEN}"
      },
      "enabled": false   // ← flip to true after adding your token
    },

    // Context7 – injects live API docs from OpenAPI specs into prompts
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },

    // ── BROWSER AUTOMATION ──────────────────────────────────────────────────

    // Playwright – full browser control, screenshots, form fill, scraping.
    // Uses the Nix-managed binary (playwright-mcp in packages.nix) + Nix-patched
    // browser binaries (playwright-driver.browsers). No runtime download ever;
    // the Nix wrapper already hard-codes PLAYWRIGHT_BROWSERS_PATH at build time.
    "playwright": {
      "type": "local",
      "command": ["playwright-mcp"],
      "enabled": true
    },
    // SearXNG – self-hosted web search (on the tailnet), no API key
    "searxng": {
      "type": "local",
      "command": ["npx", "-y", "mcp-searxng@2.5.1"],
      "environment": {
        "SEARXNG_URL": "http://100.78.136.89:8980"
      },
      "enabled": true
    }

  },

  // Instructions: ~/.config/opencode/AGENTS.md (→ dot-agents/AGENTS.md, shared with
  // Claude Code, Codex and Gemini) plus each project's own AGENTS.md, both loaded
  // by opencode itself. Listing "AGENTS.md" here again would inject it twice.
}
