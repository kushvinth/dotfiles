## --- Window Behavior ---
background-opacity      = 0.67
theme                   = Catppuccin Mocha
confirm-close-surface   = false
macos-icon              = xray
macos-icon-frame        = chrome
mouse-hide-while-typing = true
font-family             = JetBrainsMono Nerd Font
macos-window-buttons = hidden
macos-option-as-alt = true
copy-on-select = clipboard
scrollbar = never

## --- Yabai-Rice Behavior ---
window-decoration = none
window-padding-x = 0
window-padding-y = 0

## --- zellij alias ---
keybind = cmd+d=unbind
keybind = cmd+shift+d=unbind
keybind = cmd+t=unbind
keybind = cmd+shift+j=unbind
keybind = cmd+1=unbind
keybind = cmd+digit_1=unbind
keybind = cmd+2=unbind
keybind = cmd+digit_2=unbind
keybind = cmd+3=unbind
keybind = cmd+digit_3=unbind
keybind = cmd+4=unbind
keybind = cmd+digit_4=unbind
keybind = cmd+5=unbind
keybind = cmd+digit_5=unbind
keybind = cmd+6=unbind
keybind = cmd+digit_6=unbind
keybind = cmd+7=unbind
keybind = cmd+digit_7=unbind
keybind = cmd+8=unbind
keybind = cmd+digit_8=unbind
keybind = cmd+9=unbind
keybind = cmd+0=unbind

## --- Mouse Feat ---
cursor-style = bar

## --- Shell Integrations ---
shell-integration-features = no-cursor,sudo,no-title,ssh-env,ssh-terminfo

## --- Secure Input ---
# the issue wasl skhd also get this event tap; and until it clears skhd wont start
macos-auto-secure-input = false

## --- Bell ---
bell-features = system,attention,title,border

## --- Quick Terminal ---
keybind = global:cmd+shift+grave_accent=toggle_quick_terminal
keybind = cmd+shift+r=toggle_readonly
quick-terminal-position = bottom

## --- Shaders ---
custom-shader-animation = true
custom-shader = ~/dotfiles/.config/ghostty/kitty_cursor_trail.glsl
custom-shader = ~/.config/ghostty/ghostty-shaders/underwater.glsl
custom-shader = ~/.config/ghostty/ghostty-shaders/bloom.glsl
custom-shader = ~/.config/ghostty/ghostty-shaders/glitchy.glsl

